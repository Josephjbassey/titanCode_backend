# ═══════════════════════════════════════════════════════════════════════
# TitanCode Technologies — Environment Configuration Example (.env.example)
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in the actual values.
# NEVER commit the real `.env` file to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Project Info ───────────────────────────────────────────────────────
PROJECT_NAME="TitanCode Technologies"
VERSION="1.0.0"
ENVIRONMENT="development"

# ── Security & Authentication ──────────────────────────────────────────
# IMPORTANT: Generate a secure secret key for production (e.g., `openssl rand -hex 32`)
SECRET_KEY="replace_with_a_very_secure_random_string_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Admin Bootstrap (startup seed) ─────────────────────────────────────
# In production/staging, FIRST_SUPERUSER_PASSWORD MUST be changed from default.
FIRST_SUPERUSER="admin@titancode.com"
FIRST_SUPERUSER_PASSWORD="TitanCodeAdmin123!"
# Set to false in production after initial bootstrap.
AUTO_SEED_DEFAULT_ADMIN=true

# ── Database ───────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# For local dev: localhost:5432
# For Docker: db:5432
DATABASE_URL="postgresql+asyncpg://postgres:password123@db:5432/titancode"

# ── CORS Configuration ─────────────────────────────────────────────────
# List of allowed origins for frontend requests (JSON array)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8080"]'

# ── Production Hardening ──────────────────────────────────────────────
# Set to 'false' only during automated tests (handled in conftest.py)
RATE_LIMIT_ENABLED=true

# ── File Storage ───────────────────────────────────────────────────────
# Currently supports: local (S3 implementation placeholder exists)
STORAGE_TYPE="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# ── Payment Gateways (Africa) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""
