# ═══════════════════════════════════════════════════════════════════════
# TitanCode Technologies — Environment Configuration Example (.env.example)
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in the actual values.
# NEVER commit the real `.env` file to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Project Info ───────────────────────────────────────────────────────
PROJECT_NAME="TitanCode Technologies"
VERSION="1.0.0"
ENVIRONMENT="development"

# ── Security & Authentication ──────────────────────────────────────────
# IMPORTANT: Generate a secure secret key for production (e.g., `openssl rand -hex 32`)
SECRET_KEY="replace_with_a_very_secure_random_string_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Admin Bootstrap (startup seed) ─────────────────────────────────────
# In production/staging, FIRST_SUPERUSER_PASSWORD MUST be changed from default.
FIRST_SUPERUSER="admin@titancode.com"
FIRST_SUPERUSER_PASSWORD="TitanCodeAdmin123!"
# Set to false in production after initial bootstrap.
AUTO_SEED_DEFAULT_ADMIN=true

# ── Database ───────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# For local dev: localhost:5432
# For Docker: db:5432
DATABASE_URL="postgresql+asyncpg://postgres:password123@db:5432/titancode"

# ── CORS Configuration ─────────────────────────────────────────────────
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173"

# ── Production Hardening ──────────────────────────────────────────────
# Set to 'false' only during automated tests (handled in conftest.py)
RATE_LIMIT_ENABLED=true

# ── File Storage ───────────────────────────────────────────────────────
# Currently supports: local (S3 implementation placeholder exists)
STORAGE_TYPE="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# ── Payment Gateways (Paystack Transfers & Multi-Currency) ──────────────
# Paystack — https://dashboard.paystack.com/#/settings/developer
#   PAYSTACK_SECRET_KEY  : Server-side key (sk_live_… / sk_test_…). Used for all
#                          Paystack API calls (transfer initiation, charge lookup).
#                          If missing → all outgoing staff payouts will fail.
#   PAYSTACK_PUBLIC_KEY  : Client-visible key (pk_live_… / pk_test_…). Used when
#                          initiating inline charges from the backend.
#                          If missing → inline charge initialisation will fail.
PAYSTACK_SECRET_KEY=""       # Paystack Dashboard > Settings > API Keys > Secret Key
PAYSTACK_PUBLIC_KEY=""       # Paystack Dashboard > Settings > API Keys > Public Key

# Flutterwave — https://app.flutterwave.com/dashboard/settings/apis
#   FLUTTERWAVE_SECRET_KEY     : Server-side key (FLWSECK-…). Required for all
#                                Flutterwave API calls (multi-currency transfers).
#                                If missing → Flutterwave transfers will fail.
#   FLUTTERWAVE_WEBHOOK_SECRET : The "Hash" value set in Flutterwave > Webhooks.
#                                Used to verify the X-Flw-Signature header on every
#                                incoming webhook. If missing → ALL incoming
#                                Flutterwave webhooks will be rejected (403).
FLUTTERWAVE_SECRET_KEY=""    # Flutterwave Dashboard > Settings > APIs > Secret Key
FLUTTERWAVE_WEBHOOK_SECRET=""# Flutterwave Dashboard > Settings > Webhooks > Hash

# Stripe — https://dashboard.stripe.com/developers
#   STRIPE_SECRET_KEY     : Server-side key (sk_live_… / sk_test_…). Required for
#                           Stripe API calls (payment intent creation, refunds).
#                           If missing → Stripe charges will fail.
#   STRIPE_WEBHOOK_SECRET : Endpoint signing secret (whsec_…). Found under
#                           Stripe Dashboard > Developers > Webhooks > select endpoint
#                           > Signing secret. Used to verify the Stripe-Signature
#                           header. If missing → ALL incoming Stripe webhooks will be
#                           rejected (403).
STRIPE_SECRET_KEY=""         # Stripe Dashboard > Developers > API Keys > Secret Key
STRIPE_WEBHOOK_SECRET=""     # Stripe Dashboard > Developers > Webhooks > Signing secret

# ── Sumsub KYC (Identity Verification) ──────────────────────────────────
# Sumsub — https://api.sumsub.com/checkus#/developers/app-tokens
#   SUMSUB_APP_TOKEN       : App token for authenticating Sumsub API requests
#                            (creating applicants, fetching review results).
#                            If missing → KYC applicant creation will fail.
#   SUMSUB_SECRET_KEY      : HMAC-SHA256 key for signing Sumsub API requests AND
#                            for validating the X-Payload-Digest webhook header.
#                            If missing → API request signing fails AND incoming
#                            Sumsub webhooks will be rejected.
#   SUMSUB_WEBHOOK_SECRET  : Additional webhook-level secret configured in the
#                            Sumsub Dashboard > Developers > Webhooks section.
#                            If missing → Sumsub webhook signature validation is
#                            disabled (all events accepted without verification).
SUMSUB_APP_TOKEN=""          # Sumsub Dashboard > Developers > App tokens > Token
SUMSUB_SECRET_KEY=""         # Sumsub Dashboard > Developers > App tokens > Secret Key
SUMSUB_WEBHOOK_SECRET=""     # Sumsub Dashboard > Developers > Webhooks > Secret

# ── Email Configuration (SMTP) ────────────────────────────────────────
# Works with any SMTP provider (Resend, SendGrid, Amazon SES, Mailgun, Gmail)
# If SMTP_HOST is blank, emails will run in Simulated Mode (logged to console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@titancode.tech"
EMAILS_FROM_NAME="TitanCode Technologies"
